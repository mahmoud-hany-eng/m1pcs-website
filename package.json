{
  "name": "m1-gaming-pcs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "ops:validate": "node ops/validate-memory.mjs",
    "ops:test": "node --test ops/tests/*.test.mjs",
    "db:test": "node --test supabase/tests/db.test.mjs supabase/tests/db.plat0003.test.mjs",
    "gateway:diag:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test supabase/tests/gateway-diagnostics.test.mjs",
    "gateway:tls:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test supabase/tests/gateway-tls.test.mjs",
    "db:test:static": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test supabase/tests/static.test.mjs supabase/tests/platform-lib.test.mjs supabase/tests/accounts-lib.test.mjs supabase/tests/staff-lib.test.mjs",
    "accounts:e2e": "node --disable-warning=ExperimentalWarning --test supabase/tests/accounts.e2e.test.mjs",
    "workflow:db:test": "node --disable-warning=ExperimentalWarning --test supabase/tests/workflow.db.test.mjs",
    "workflow:idempotency:test": "node --disable-warning=ExperimentalWarning --test supabase/tests/idempotency.db.test.mjs",
    "workflow:e2e": "node --disable-warning=ExperimentalWarning --test supabase/tests/workflow.customer.e2e.test.mjs",
    "accounts:preview": "node --disable-warning=ExperimentalWarning supabase/emulator/preview.mjs",
    "real:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test-concurrency=1 --test supabase/tests/real/real-stack.api.test.mjs supabase/tests/real/real-stack.staff.test.mjs",
    "real:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test-concurrency=1 --test supabase/tests/real/real-stack.customer.e2e.test.mjs supabase/tests/real/real-stack.admin.e2e.test.mjs",
    "workflow:window:test": "node --disable-warning=ExperimentalWarning --test supabase/tests/idempotency.window.db.test.mjs",
    "release:db:test": "node --disable-warning=ExperimentalWarning --test supabase/tests/release.db.test.mjs",
    "gateway:outcomes:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test supabase/tests/gateway-outcomes.db.test.mjs",
    "workflow:hook:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test supabase/tests/idempotency.hook.browser.test.mjs",
    "test:db": "M1_REQUIRE_PG=1 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test-concurrency=2 --test supabase/tests/static.test.mjs supabase/tests/platform-lib.test.mjs supabase/tests/accounts-lib.test.mjs supabase/tests/staff-lib.test.mjs supabase/tests/gateway-tls.test.mjs supabase/tests/gateway-diagnostics.test.mjs supabase/tests/db.test.mjs supabase/tests/db.plat0003.test.mjs supabase/tests/workflow.db.test.mjs supabase/tests/idempotency.db.test.mjs supabase/tests/idempotency.window.db.test.mjs supabase/tests/release.db.test.mjs supabase/tests/gateway-outcomes.db.test.mjs",
    "test:browser": "M1_REQUIRE_PG=1 M1_REQUIRE_PLAYWRIGHT=1 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test-concurrency=1 --test supabase/tests/accounts.e2e.test.mjs supabase/tests/workflow.customer.e2e.test.mjs supabase/tests/idempotency.hook.browser.test.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "framer-motion": "^13.4.1",
    "next": "^15.5.0",
    "pg": "8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "0.35.4",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^15.5.0",
    "playwright": "1.63.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2"
  }
}
