{
  "$id": "m1-ops/policy.schema.json",
  "title": "M1 deterministic policy",
  "description": "Strict contract for docs/project-memory/policy/policy.json. Risk classes are computed from this file by trusted code, never from a model's self-classification.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1",
      "description": "Schema version of this contract."
    },
    "policy_id": {
      "type": "string",
      "description": "Stable policy identifier.",
      "minLength": 3,
      "maxLength": 80
    },
    "policy_version": {
      "type": "string",
      "description": "Semantic version of the policy.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft_pending_human_review",
        "active"
      ],
      "description": "Only a human may set active."
    },
    "owner": {
      "const": "human",
      "description": "This file is human-owned. Workers and models may propose changes but never approve them."
    },
    "provenance": {
      "type": "string",
      "description": "Where the initial values come from and what is still undecided.",
      "minLength": 10,
      "maxLength": 1500
    },
    "task_id_prefixes": {
      "type": "array",
      "description": "Allowed task id prefixes.",
      "items": {
        "type": "string",
        "description": "A task id prefix.",
        "pattern": "^[A-Z]{3,5}$"
      },
      "minItems": 1,
      "maxItems": 10
    },
    "branches": {
      "type": "object",
      "description": "Branch model.",
      "properties": {
        "production": {
          "type": "string",
          "description": "Production branch. Merging into it is the production deploy.",
          "minLength": 1
        },
        "integration": {
          "type": "string",
          "description": "Integration branch (preview deployments only).",
          "minLength": 1
        },
        "worker_branch_prefix": {
          "const": "claude/",
          "description": "Prefix of every worker branch."
        },
        "worker_may_push": {
          "type": "array",
          "description": "Branches a worker may push to when pushing is authorized.",
          "items": {
            "$ref": "#/$defs/glob_pattern"
          },
          "minItems": 1
        },
        "worker_must_not_push": {
          "type": "array",
          "description": "Branches a worker must never push to.",
          "items": {
            "type": "string",
            "description": "A branch name."
          },
          "minItems": 1
        },
        "merge_into_integration": {
          "type": "string",
          "enum": [
            "orchestrator_after_all_gates_pass",
            "human_only"
          ],
          "description": "Who may merge into the integration branch."
        },
        "merge_into_production": {
          "const": "human_only",
          "description": "Always human-only."
        },
        "force_push": {
          "const": "never",
          "description": "Force pushes are never allowed."
        },
        "pushes_currently_authorized": {
          "type": "boolean",
          "description": "False until a human records a standing push authorization in HUMAN_DECISIONS.md and flips this value."
        }
      },
      "required": [
        "production",
        "integration",
        "worker_branch_prefix",
        "worker_may_push",
        "worker_must_not_push",
        "merge_into_integration",
        "merge_into_production",
        "force_push",
        "pushes_currently_authorized"
      ],
      "additionalProperties": false
    },
    "risk_classes": {
      "type": "object",
      "description": "Risk classes.",
      "properties": {
        "A": {
          "type": "object",
          "description": "Class A.",
          "properties": {
            "name": {
              "type": "string",
              "description": "Short name.",
              "minLength": 1,
              "maxLength": 40
            },
            "description": {
              "type": "string",
              "description": "What belongs in this class.",
              "minLength": 10,
              "maxLength": 1000
            },
            "approval": {
              "type": "string",
              "enum": [
                "automatic_when_all_gates_pass",
                "human_approval_before_run",
                "never_autonomous"
              ],
              "description": "Approval model."
            },
            "runs_without_human_approval": {
              "type": "boolean",
              "description": "True if the orchestrator may start a task of this class without a human approval."
            },
            "may_auto_merge_to_integration": {
              "type": "boolean",
              "description": "True if the orchestrator may merge into the integration branch without a human."
            },
            "max_changed_files": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Cap for automatic handling, or null."
            },
            "max_changed_lines": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Cap for automatic handling, or null."
            }
          },
          "required": [
            "name",
            "description",
            "approval",
            "runs_without_human_approval",
            "may_auto_merge_to_integration",
            "max_changed_files",
            "max_changed_lines"
          ],
          "additionalProperties": false
        },
        "B": {
          "type": "object",
          "description": "Class B.",
          "properties": {
            "name": {
              "type": "string",
              "description": "Short name.",
              "minLength": 1,
              "maxLength": 40
            },
            "description": {
              "type": "string",
              "description": "What belongs in this class.",
              "minLength": 10,
              "maxLength": 1000
            },
            "approval": {
              "type": "string",
              "enum": [
                "automatic_when_all_gates_pass",
                "human_approval_before_run",
                "never_autonomous"
              ],
              "description": "Approval model."
            },
            "runs_without_human_approval": {
              "type": "boolean",
              "description": "True if the orchestrator may start a task of this class without a human approval."
            },
            "may_auto_merge_to_integration": {
              "type": "boolean",
              "description": "True if the orchestrator may merge into the integration branch without a human."
            },
            "max_changed_files": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Cap for automatic handling, or null."
            },
            "max_changed_lines": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Cap for automatic handling, or null."
            }
          },
          "required": [
            "name",
            "description",
            "approval",
            "runs_without_human_approval",
            "may_auto_merge_to_integration",
            "max_changed_files",
            "max_changed_lines"
          ],
          "additionalProperties": false
        },
        "C": {
          "type": "object",
          "description": "Class C.",
          "properties": {
            "name": {
              "type": "string",
              "description": "Short name.",
              "minLength": 1,
              "maxLength": 40
            },
            "description": {
              "type": "string",
              "description": "What belongs in this class.",
              "minLength": 10,
              "maxLength": 1000
            },
            "approval": {
              "type": "string",
              "enum": [
                "automatic_when_all_gates_pass",
                "human_approval_before_run",
                "never_autonomous"
              ],
              "description": "Approval model."
            },
            "runs_without_human_approval": {
              "type": "boolean",
              "description": "True if the orchestrator may start a task of this class without a human approval."
            },
            "may_auto_merge_to_integration": {
              "type": "boolean",
              "description": "True if the orchestrator may merge into the integration branch without a human."
            },
            "max_changed_files": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Cap for automatic handling, or null."
            },
            "max_changed_lines": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Cap for automatic handling, or null."
            }
          },
          "required": [
            "name",
            "description",
            "approval",
            "runs_without_human_approval",
            "may_auto_merge_to_integration",
            "max_changed_files",
            "max_changed_lines"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "A",
        "B",
        "C"
      ],
      "additionalProperties": false
    },
    "risk_categories": {
