    "path_rules": {
      "type": "array",
      "description": "Path rules applied to the actual changed paths.",
      "items": {
        "type": "object",
        "description": "A path rule. All matching rules apply; the highest minimum class and the most restrictive restriction win.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Rule identifier.",
            "pattern": "^PATH-[0-9]{3}$"
          },
          "patterns": {
            "type": "array",
            "description": "Globs the rule applies to.",
            "items": {
              "$ref": "#/$defs/glob_pattern_or_wild"
            },
            "minItems": 1
          },
          "exclude": {
            "type": "array",
            "description": "Globs excluded from the rule.",
            "items": {
              "$ref": "#/$defs/glob_pattern_or_wild"
            }
          },
          "category": {
            "$ref": "#/$defs/risk_category"
          },
          "restriction": {
            "type": "string",
            "enum": [
              "none",
              "protected",
              "control_plane",
              "immutable"
            ],
            "description": "none: normal. protected: human review before merge. control_plane: protected, must be explicitly listed in files_allowed, never auto-merged. immutable: any change is a violation."
          },
          "note": {
            "type": "string",
            "description": "Why the rule exists.",
            "minLength": 3,
            "maxLength": 400
          }
        },
        "required": [
          "id",
          "patterns",
          "exclude",
          "category",
          "restriction",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "classification": {
      "type": "object",
      "description": "How the authoritative class is computed.",
      "properties": {
        "rule": {
          "const": "maximum_of_all_signals",
          "description": "The final class is the maximum of all signals."
        },
        "signals": {
          "type": "array",
          "description": "Signals combined into the final class.",
          "items": {
            "type": "string",
            "description": "A signal name."
          },
          "minItems": 1
        },
        "model_self_classification": {
          "const": "advisory_may_raise_never_lower",
          "description": "Declared or model-assigned classes can raise the computed class, never lower it."
        },
        "authoritative_inputs": {
          "type": "array",
          "description": "Inputs the policy engine trusts.",
          "items": {
            "type": "string",
            "description": "An input name."
          },
          "minItems": 1
        },
        "prohibited_operation_class": {
          "const": "C",
          "description": "Any prohibited operation makes the task class C."
        },
        "unmatched_path_category": {
          "$ref": "#/$defs/risk_category"
        }
      },
      "required": [
        "rule",
        "signals",
        "model_self_classification",
        "authoritative_inputs",
        "prohibited_operation_class",
        "unmatched_path_category"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "description": "Manual approval requirements.",
      "properties": {
        "human_approval_before_run_for_classes": {
          "type": "array",
          "description": "Classes that need a human approval before a run starts.",
          "items": {
            "$ref": "#/$defs/risk_class"
          }
        },
        "never_autonomous_for_classes": {
          "type": "array",
          "description": "Classes that never run autonomously.",
          "items": {
            "$ref": "#/$defs/risk_class"
          }
        },
        "human_approval_before_merge_for_restrictions": {
          "type": "array",
          "description": "Restrictions that need a human approval before merge.",
          "items": {
            "type": "string",
            "enum": [
              "protected",
              "control_plane",
              "immutable"
            ],
            "description": "A restriction."
          }
        },
        "milestone_gate_required_at_end_of_each_phase": {
          "type": "boolean",
          "description": "A human signs off at the end of every roadmap phase."
        },
        "channel": {
          "type": "object",
          "description": "Approval channel.",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "not_configured",
                "configured"
              ],
              "description": "Whether an approval channel exists."
            },
            "planned": {
              "type": "string",
              "description": "Planned channel.",
              "minLength": 3,
              "maxLength": 300
            },
            "interim": {
              "type": "string",
              "description": "Interim channel until configured.",
              "minLength": 3,
              "maxLength": 300
            }
          },
          "required": [
            "status",
            "planned",
            "interim"
          ],
          "additionalProperties": false
        },
        "approval_reference_format": {
          "type": "string",
          "description": "Format of a recorded approval.",
          "minLength": 3,
          "maxLength": 60
        }
      },
      "required": [
        "human_approval_before_run_for_classes",
        "never_autonomous_for_classes",
        "human_approval_before_merge_for_restrictions",
        "milestone_gate_required_at_end_of_each_phase",
        "channel",
        "approval_reference_format"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "description": "Run limits.",
      "properties": {
        "max_attempts_per_task": {
          "type": "integer",
          "description": "Maximum attempts per task.",
          "minimum": 1,
          "maximum": 5
        },
        "max_tasks_per_day": {
          "type": "integer",
          "description": "Maximum tasks started per UTC day.",
          "minimum": 1,
          "maximum": 50
        },
        "max_concurrent_tasks": {
          "type": "integer",
          "description": "Maximum tasks in flight at once.",
          "minimum": 1,
          "maximum": 3
        },
        "max_consecutive_auto_tasks": {
          "type": "integer",
          "description": "Auto-approved tasks in a row before a human checkpoint.",
          "minimum": 1,
          "maximum": 10
        },
        "max_fires_per_hour": {
          "type": "integer",
          "description": "Maximum worker launches per hour (well under the provider limit).",
          "minimum": 1,
          "maximum": 30
        },
        "max_task_wall_clock_minutes": {
          "type": "integer",
          "description": "A task with no valid report after this long is marked stalled.",
          "minimum": 5,
          "maximum": 480
        },
        "max_review_sessions_per_attempt": {
          "type": "integer",
          "description": "Maximum reviewer sessions per attempt.",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "max_attempts_per_task",
        "max_tasks_per_day",
        "max_concurrent_tasks",
        "max_consecutive_auto_tasks",
        "max_fires_per_hour",
        "max_task_wall_clock_minutes",
        "max_review_sessions_per_attempt"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "description": "Usage and billing controls. There is no paid AI service in this system.",
      "properties": {
        "status": {
          "const": "placeholder",
          "description": "Usage values are placeholders until a human decides."
        },
        "paid_ai_services_allowed": {
          "const": false,
          "description": "Owner decision (HD-0010): no additional paid AI service of any kind. Changing this requires a new human decision and a change to this schema, which is a control-plane change."
        },
        "api_billing_allowed": {
          "const": false,
          "description": "Owner decision (HD-0010): no API-key billing from any provider, including a console API key. Only the existing subscription is used."
        },
        "claude_subscription": {
          "type": "object",
          "description": "How the existing subscription is used and protected.",
          "properties": {
            "daily_run_allowance": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Daily cloud run allowance of the account, or null until confirmed."
            },
            "allowance_source": {
              "type": "string",
              "description": "Where the value must be confirmed.",
              "minLength": 3,
              "maxLength": 300
            },
            "extra_usage_must_stay_disabled": {
              "const": true,
              "description": "Metered overage ('extra usage') on the account must stay off, because it is API-rate billing."
            }
          },
          "required": [
            "daily_run_allowance",
            "allowance_source",
            "extra_usage_must_stay_disabled"
          ],
          "additionalProperties": false
        },
        "on_exhaustion": {
          "const": "halt_and_notify",
          "description": "Behavior when the subscription's usage limit is reached: stop and tell a human; never buy more."
        }
      },
      "required": [
        "status",
        "paid_ai_services_allowed",
        "api_billing_allowed",
        "claude_subscription",
        "on_exhaustion"
      ],
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "description": "Role separation. These are constants: loosening one is a control-plane change that needs a human.",
      "properties": {
        "developer": {
          "type": "object",
          "description": "The worker role.",
          "properties": {
            "may_review_own_work": {
              "const": false,
              "description": "A worker never reviews its own work."
            },
            "may_approve": {
              "const": false,
              "description": "A worker never approves anything."
            },
            "may_merge": {
              "const": false,
              "description": "A worker never merges."
            }
          },
          "required": [
            "may_review_own_work",
            "may_approve",
            "may_merge"
          ],
          "additionalProperties": false
        },
        "reviewer": {
          "type": "object",
          "description": "The reviewer role.",
          "properties": {
            "must_be_separate_session": {
              "const": true,
              "description": "A reviewer is always a different session from the worker of the attempt it reviews."
            },
            "tool_access": {
              "const": "read_only",
              "description": "A reviewer session may only read: no shell, no file writes outside its own output, no network tools."
            },
            "may_change_code": {
              "const": false,
              "description": "A reviewer never changes code."
            },
            "may_approve": {
              "const": false,
              "description": "A reviewer never approves; it advises."
            },
            "may_merge": {
              "const": false,
              "description": "A reviewer never merges."
            },
            "may_launch_tasks": {
              "const": false,
              "description": "A reviewer never starts a task."
            },
            "verdict_authority": {
              "const": "advisory_only",
              "description": "The reviewer's verdict is an input to the policy engine, never a decision."
            }
          },
          "required": [
            "must_be_separate_session",
            "tool_access",
            "may_change_code",
            "may_approve",
            "may_merge",
            "may_launch_tasks",
            "verdict_authority"
          ],
          "additionalProperties": false
        },
        "policy_engine": {
          "type": "object",
          "description": "The deterministic policy engine.",
          "properties": {
            "decides": {
              "type": "array",
              "description": "What deterministic code decides.",
              "items": {
                "type": "string",
                "enum": [
                  "risk_class",
                  "merge_eligibility",
                  "next_task_eligibility",
                  "stop_conditions"
                ],
                "description": "A decision area."
              },
              "minItems": 1
            },
            "uses_models": {
              "const": false,
              "description": "No model participates in the decision itself."
            }
          },
          "required": [
            "decides",
            "uses_models"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "developer",
        "reviewer",
        "policy_engine"
      ],
      "additionalProperties": false
    },
    "reviewer_runtime": {
      "type": "object",
      "description": "Which separate-session runtime performs reviews. Undecided until a human decides.",
      "properties": {
        "allowed": {
          "type": "array",
          "description": "Runtimes a reviewer may use.",
          "items": {
            "type": "string",
            "enum": [
              "actions_hosted_session",
              "cloud_routine_session"
            ],
            "description": "A runtime."
          },
          "minItems": 1
        },
        "selected": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "actions_hosted_session",
            "cloud_routine_session"
          ],
          "description": "The runtime chosen by a human, or null while undecided."
        },
        "decision_reference": {
          "type": [
            "string",
            "null"
          ],
          "description": "The human decision (HD-<4 digits>) that selected the runtime, or null while undecided.",
          "pattern": "^HD-[0-9]{4}$"
        },
        "governing_question": {
          "type": "string",
          "description": "The open question that governs the choice.",
          "pattern": "^OQ-[0-9]{4}$"
        }
      },
      "required": [
        "allowed",
        "selected",
        "decision_reference",
        "governing_question"
      ],
      "additionalProperties": false
    },
    "kill_switch": {
      "type": "object",
      "description": "Kill switch.",
      "properties": {
        "repository_variable": {
          "type": "string",
          "description": "Name of the repository variable that enables the system.",
          "minLength": 3,
          "maxLength": 60
        },
        "required_value": {
          "type": "string",
          "description": "Value that means enabled.",
          "minLength": 1,
          "maxLength": 20
        },
        "default_when_unset": {
          "const": "disabled",
          "description": "Fail closed: an unset variable means disabled."
        },
        "kill_file": {
          "type": "string",
          "description": "Presence of this file halts the system.",
          "minLength": 3,
          "maxLength": 100
        },
        "state_branch_flag": {
          "type": "string",
          "description": "Flag name in the state store that halts the system.",
          "minLength": 1,
          "maxLength": 60
        },
        "on_trigger": {
          "type": "array",
          "description": "Actions taken when triggered.",
          "items": {
            "type": "string",
            "enum": [
              "stop_dispatching_new_tasks",
              "stop_calling_external_apis",
              "keep_writing_audit_log",
              "require_human_resume"
            ],
            "description": "An action."
          },
          "minItems": 1
        },
        "resume": {
          "const": "human_only",
          "description": "Only a human may resume."
        }
      },
      "required": [
        "repository_variable",
        "required_value",
        "default_when_unset",
        "kill_file",
        "state_branch_flag",
        "on_trigger",
        "resume"
      ],
      "additionalProperties": false
    },
    "prohibited_operations": {
      "type": "array",
      "description": "Operations no autonomous run may perform. Detecting one makes the task class C and stops it.",
      "items": {
        "type": "object",
        "description": "A prohibited operation.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier.",
            "pattern": "^PROHIB-[0-9]{3}$"
          },
          "operation": {
            "type": "string",
            "description": "The prohibited operation.",
            "minLength": 5,
            "maxLength": 300
          },
          "class": {
            "const": "C",
            "description": "Always class C."
          }
        },
        "required": [
          "id",
          "operation",
          "class"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "memory_contract": {
      "type": "object",
      "description": "What the offline validator requires of project memory.",
      "properties": {
        "required_files": {
          "type": "array",
          "description": "Files that must exist.",
          "items": {
            "type": "string",
            "description": "A repository-relative path."
          },
          "minItems": 1
        },
        "min_adr_count": {
          "type": "integer",
          "description": "Minimum number of ADR files.",
          "minimum": 1,
          "maximum": 100
        },
        "required_requirement_ids": {
          "type": "array",
          "description": "Confirmed requirements that must not be silently removed.",
          "items": {
            "type": "string",
            "description": "A requirement id.",
            "pattern": "^REQ-[A-Z]{2,5}-[0-9]{3}$"
          },
          "minItems": 1
        },
        "required_requirement_text": {
          "type": "array",
          "description": "Guards against silent edits of confirmed facts.",
          "items": {
            "type": "object",
            "description": "Text guard for a confirmed requirement.",
            "properties": {
              "id": {
                "type": "string",
                "description": "Requirement id.",
                "pattern": "^REQ-[A-Z]{2,5}-[0-9]{3}$"
              },
              "must_contain": {
                "type": "array",
                "description": "Substrings the requirement text must contain.",
                "items": {
                  "type": "string",
                  "description": "A required substring (case-insensitive)."
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "must_contain"
            ],
            "additionalProperties": false
          }
        },
        "claude_md_required_headings": {
          "type": "array",
          "description": "Headings CLAUDE.md must contain.",
          "items": {
            "type": "string",
            "description": "An exact heading line."
          },
          "minItems": 1
        },
        "content_scan": {
          "type": "object",
          "description": "Public-repository content scan.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Scan for secrets and business-sensitive patterns."
            },
            "scan_roots": {
              "type": "array",
              "description": "Roots to scan.",
              "items": {
                "type": "string",
                "description": "A file or directory."
              },
              "minItems": 1
            },
            "allowed_emails": {
              "type": "array",
              "description": "Email addresses permitted in the public repository.",
              "items": {
                "type": "string",
                "description": "An allowed address."
              }
            }
          },
          "required": [
            "enabled",
            "scan_roots",
            "allowed_emails"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "required_files",
        "min_adr_count",
        "required_requirement_ids",
        "required_requirement_text",
        "claude_md_required_headings",
        "content_scan"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "status",
    "owner",
    "provenance",
    "task_id_prefixes",
    "branches",
    "risk_classes",
    "risk_categories",
    "path_rules",
    "classification",
    "approval",
    "limits",
    "budget",
    "roles",
    "reviewer_runtime",
    "kill_switch",
    "prohibited_operations",
    "memory_contract"
  ],
  "additionalProperties": false,
  "$defs": {
    "risk_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ],
      "description": "Risk class. The authoritative class is computed by trusted policy logic from policy.json; a value supplied by a task author, worker or model is advisory and can only raise the computed class."
    },
    "risk_category": {
      "type": "string",
      "enum": [
        "docs_only",
        "tests_only",
        "ui_public_site",
        "build_config",
        "dependencies",
        "ci_workflows",
        "ops_control_plane",
        "policy_or_schema",
        "auth_or_sessions",
        "database_schema",
        "rls_or_authorization",
        "loyalty_or_finance_logic",
        "customer_data",
        "external_api_integration",
        "scope_creep",
        "other",
        "secrets_or_credentials",
        "production_deploy",
        "billing_or_paid_service",
        "destructive_operation",
        "infrastructure_settings"
      ],
      "description": "Risk category. Must be a key of policy.risk_categories."
    },
    "glob_pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._@/*?+\\-]+$",
      "description": "Repository-relative path glob. No leading slash and no '..'. Supports *, ** and ?."
    },
    "glob_pattern_or_wild": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._@/*?+\\-]+$",
      "description": "Repository-relative path glob. Unlike task globs, a leading wildcard is allowed here because rules are evaluated against concrete paths."
    }
  }
}
