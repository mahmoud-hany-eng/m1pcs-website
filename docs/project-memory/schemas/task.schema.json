{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m1-ops/task.schema.json",
  "title": "M1 development task (JSON front matter of a task file)",
  "description": "Strict contract for the JSON front matter of docs/project-memory/tasks/<task id>-<slug>.md. The markdown body is the human-readable prompt and is not validated beyond being present.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1",
      "description": "Schema version of this contract."
    },
    "task_id": {
      "$ref": "#/$defs/task_id"
    },
    "title": {
      "type": "string",
      "description": "Short imperative title.",
      "minLength": 5,
      "maxLength": 120
    },
    "objective": {
      "type": "string",
      "description": "What the task must achieve and why, in plain language.",
      "minLength": 20,
      "maxLength": 2000
    },
    "depends_on": {
      "type": "array",
      "description": "Tasks that must be done first.",
      "items": {
        "$ref": "#/$defs/task_id"
      },
      "maxItems": 20
    },
    "blocked_by_open_questions": {
      "type": "array",
      "description": "Open questions that must be resolved before this task may run. A non-empty list forces human handling.",
      "items": {
        "$ref": "#/$defs/open_question_ref"
      },
      "maxItems": 20
    },
    "requirement_refs": {
      "type": "array",
      "description": "Confirmed requirements this task serves.",
      "items": {
        "$ref": "#/$defs/requirement_ref"
      },
      "maxItems": 40
    },
    "declared_risk_class": {
      "$ref": "#/$defs/risk_class"
    },
    "declared_risk_categories": {
      "type": "array",
      "description": "Categories the author expects the change to touch.",
      "items": {
        "$ref": "#/$defs/risk_category"
      },
      "minItems": 1,
      "maxItems": 21
    },
    "base_branch": {
      "type": "string",
      "description": "Branch the work branch is created from.",
      "pattern": "^[A-Za-z0-9._/\\-]+$",
      "maxLength": 100
    },
    "branch": {
      "type": "string",
      "description": "Work branch. Must start with claude/ and embed the lower-case task id.",
      "pattern": "^claude/[a-z]{3,5}-[0-9]{4}-[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "files_allowed": {
      "type": "array",
      "description": "Globs the worker may change. Each must start with a literal path segment (no leading wildcard).",
      "items": {
        "$ref": "#/$defs/glob_pattern"
      },
      "minItems": 1,
      "maxItems": 60
    },
    "files_forbidden": {
      "type": "array",
      "description": "Globs the worker must not change, even if matched by files_allowed.",
      "items": {
        "$ref": "#/$defs/glob_pattern"
      },
      "maxItems": 60
    },
    "out_of_scope": {
      "type": "array",
      "description": "Explicit non-goals.",
      "items": {
        "type": "string",
        "description": "An explicit non-goal.",
        "minLength": 3,
        "maxLength": 300
      },
      "maxItems": 40
    },
    "acceptance_criteria": {
      "type": "array",
      "description": "Verifiable criteria.",
      "items": {
        "$ref": "#/$defs/acceptance_criterion"
      },
      "minItems": 1,
      "maxItems": 40
    },
    "required_checks": {
      "type": "array",
      "description": "Commands whose results must be recorded as evidence.",
      "items": {
        "$ref": "#/$defs/required_check"
      },
      "maxItems": 20
    },
    "max_attempts": {
      "type": "integer",
      "description": "Maximum attempts for this task; may not exceed policy.limits.max_attempts_per_task.",
      "minimum": 1,
      "maximum": 5
    },
    "approval_reference": {
      "type": [
        "string",
        "null"
      ],
      "description": "Human decision that approved this task (HD-<4 digits>), or null when approval is recorded elsewhere.",
      "pattern": "^HD-[0-9]{4}$"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "created_by": {
      "type": "string",
      "enum": [
        "human",
        "architect",
        "claude"
      ],
      "description": "Who authored the task file. Authorship grants no approval."
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "title",
    "objective",
    "depends_on",
    "blocked_by_open_questions",
    "requirement_refs",
    "declared_risk_class",
    "declared_risk_categories",
    "base_branch",
    "branch",
    "files_allowed",
    "files_forbidden",
    "out_of_scope",
    "acceptance_criteria",
    "required_checks",
    "max_attempts",
    "approval_reference",
    "created_at",
    "created_by"
  ],
  "additionalProperties": false,
  "$defs": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z]{3,5}-[0-9]{4}$",
      "description": "Stable task identifier: <PREFIX>-<4 digits>. The prefix must be listed in policy.task_id_prefixes."
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full 40-character lowercase git commit SHA."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC ISO-8601 timestamp with second precision and a trailing Z."
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ],
      "description": "Risk class. The authoritative class is computed by trusted policy logic from policy.json; a value supplied by a task author, worker or model is advisory and can only raise the computed class."
    },
    "risk_category": {
      "type": "string",
      "enum": [
        "docs_only",
        "tests_only",
        "ui_public_site",
        "build_config",
        "dependencies",
        "ci_workflows",
        "ops_control_plane",
        "policy_or_schema",
        "auth_or_sessions",
        "database_schema",
        "rls_or_authorization",
        "loyalty_or_finance_logic",
        "customer_data",
        "external_api_integration",
        "scope_creep",
        "other",
        "secrets_or_credentials",
        "production_deploy",
        "billing_or_paid_service",
        "destructive_operation",
        "infrastructure_settings"
      ],
      "description": "Risk category. Must be a key of policy.risk_categories."
    },
    "glob_pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._@/*?+\\-]+$",
      "description": "Repository-relative path glob. No leading slash and no '..'. Supports *, ** and ?."
    },
    "requirement_ref": {
      "type": "string",
      "pattern": "^REQ-[A-Z]{2,5}-[0-9]{3}$",
      "description": "Reference to a confirmed requirement in MASTER_REQUIREMENTS.md."
    },
    "open_question_ref": {
      "type": "string",
      "pattern": "^OQ-[0-9]{4}$",
      "description": "Reference to an entry in OPEN_QUESTIONS.md."
    },
    "acceptance_criterion": {
      "type": "object",
      "description": "One verifiable acceptance criterion.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[0-9]{1,3}$",
          "description": "Criterion identifier, unique within the task."
        },
        "statement": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500,
          "description": "What must be true."
        },
        "verification_method": {
          "type": "string",
          "enum": [
            "command",
            "test",
            "inspection"
          ],
          "description": "How it is verified."
        },
        "command": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300,
          "description": "Command that verifies it, or null for inspection."
        }
      },
      "required": [
        "id",
        "statement",
        "verification_method",
        "command"
      ],
      "additionalProperties": false
    },
    "required_check": {
      "type": "object",
      "description": "A command whose result must appear as evidence in the run report.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,40}$",
          "description": "Check identifier; the run report must contain a verification entry with the same check_id."
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Exact command line."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "What the check proves."
        },
        "must_pass": {
          "type": "boolean",
          "description": "True when a non-passing result blocks completion."
        }
      },
      "required": [
        "id",
        "command",
        "description",
        "must_pass"
      ],
      "additionalProperties": false
    }
  }
}
