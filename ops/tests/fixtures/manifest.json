    {
      "file": "invalid/task-missing-objective.json",
      "kind": "task",
      "why": "A required field is absent.",
      "expect": [
        "missing required property \"objective\""
      ]
    },
    {
      "file": "invalid/task-extra-property.json",
      "kind": "task",
      "why": "Unknown fields are rejected (strict schema).",
      "expect": [
        "unexpected property \"priority\""
      ]
    },
    {
      "file": "invalid/task-bad-id.json",
      "kind": "task",
      "why": "Task ids have a fixed format.",
      "expect": [
        "does not match pattern"
      ]
    },
    {
      "file": "invalid/task-unknown-prefix.json",
      "kind": "task",
      "why": "The prefix must be listed in the policy.",
